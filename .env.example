# Meta WhatsApp Cloud API
# Get from: developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=any_secret_string_you_choose

# Claude / Anthropic API
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
# Get from: supabase.com → your project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Server
PORT=3000
